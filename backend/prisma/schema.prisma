// Prisma Schema for Todo App v1
// Defines the database models for managing todo lists and items
// Database: PostgreSQL
// Migrations: Auto-generated via `prisma migrate`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// List model represents a collection of shopping/todo tasks
// Each list contains multiple tasks
model List {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relation to tasks in this list
  tasks     Task[]

  @@map("lists")
}

// Task model represents top-level tasks/categories
// Examples: Groceries, Hardware, Medicine
// Each task belongs to a specific list and can contain multiple subtasks
model Task {
  id          String    @id @default(uuid())
  listId      String
  text        String
  description String?
  price       Decimal?  // Budget for this task
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign key relation to List
  list        List      @relation(fields: [listId], references: [id], onDelete: Cascade)

  // Relation to subtasks
  subtasks    SubTask[]

  // Indexes for efficient querying
  @@index([listId])
  @@map("tasks")
}

// SubTask model represents individual items within a task
// Examples: Milk (under Groceries), Screws (under Hardware)
// Each subtask belongs to a specific task
model SubTask {
  id        String   @id @default(uuid())
  taskId    String
  text      String
  price     Decimal?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign key relation to Task
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Indexes for efficient querying
  @@index([taskId])
  @@map("subtasks")
}
