// Prisma Schema for Todo App v1
// Defines the database models for managing todo lists and items
// Database: PostgreSQL
// Migrations: Auto-generated via `prisma migrate`

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// List model represents a collection of todo items
// Each list can contain multiple items
model List {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  // Relation to items in this list
  items     Item[]

  @@map("lists")
}

// Item model represents individual todo items
// Each item belongs to a specific list
// Items can be organized hierarchically: groups (parentItemId = null) contain sub-tasks (parentItemId = groupId)
model Item {
  id           String   @id @default(uuid())
  listId       String
  text         String
  done         Boolean  @default(false)
  price        Decimal?
  parentItemId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Foreign key relation to List
  list         List     @relation(fields: [listId], references: [id], onDelete: Cascade)

  // Self-referential relation for hierarchical items (groups → sub-tasks)
  // parent: points to parent item if this is a sub-task (null if this is a group)
  // children: contains all child items if this is a group
  parent       Item?    @relation("ChildItems", fields: [parentItemId], references: [id], onDelete: Cascade)
  children     Item[]   @relation("ChildItems")

  // Indexes for efficient querying
  @@index([listId])
  @@index([parentItemId])
  @@map("items")
}
